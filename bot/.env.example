# =============================================================================
# Prop Firm Trading Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# SECURITY: Master Encryption Key (REQUIRED)
# ---------------------------------------------------------------------------
# This key is used to AES-256-GCM encrypt MetaAPI tokens at rest.
# Generate a strong key: openssl rand -hex 32
# Store it securely — if lost, stored tokens CANNOT be decrypted.
MASTER_KEY=change_me_in_production_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Provider Selection
# ---------------------------------------------------------------------------
# Choose your trading provider: "mt5" for local MetaTrader 5, "metaapi" for cloud
PROVIDER_TYPE=metaapi

# ---------------------------------------------------------------------------
# Prop Firm Selection
# ---------------------------------------------------------------------------
# "fundingpips"  — 2-step challenge (10K / 50K / 100K / 200K)
# "the5ers"      — 3-step bootcamp (5K only)
PROP_FIRM=fundingpips

# Account size (must match your challenge)
# FundingPips: 10000, 50000, 100000, 200000
# The5%ers: 5000
ACCOUNT_SIZE=10000

# Phase: phase1, phase2, funded
PHASE=phase1

# For The5%ers 3-step: step 1, 2, or 3
THE5ERS_STEP=1

# ---------------------------------------------------------------------------
# MetaAPI Cloud Credentials
# ---------------------------------------------------------------------------
# These can also be set via the Dashboard (securely encrypted).
# If set here, they are used as fallback. Dashboard values take priority.
METAAPI_TOKEN=your_metaapi_token
METAAPI_ACCOUNT_ID=your_account_id
METAAPI_REGION=new-york

# ---------------------------------------------------------------------------
# MetaTrader 5 Credentials (used by both MT5 local and MetaAPI)
# ---------------------------------------------------------------------------
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=FundingPips-Server

# ---------------------------------------------------------------------------
# Telegram Notifications
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# Optional: Override config.json values
# ---------------------------------------------------------------------------
# RISK_PER_TRADE=0.005
# DAILY_LOSS_LIMIT=0.02
# MAX_DRAWDOWN=0.08
