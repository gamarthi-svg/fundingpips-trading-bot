# Prop Firm Trading Bot Dashboard — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The dashboard expects these variables at build time (Vite prefix).

# ── API Backend ─────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend server
VITE_API_URL=http://localhost:8080

# WebSocket URL (derived from API_BASE if not set)
# VITE_WS_URL=ws://localhost:8080/ws

# ── Dashboard Settings ──────────────────────────────────────────────────────
# Dashboard title shown in browser tab and header
VITE_DASHBOARD_TITLE="Prop Firm Trading Bot"

# Theme: "dark" | "light"
VITE_THEME=dark

# Refresh intervals (milliseconds) — these can be overridden per-hook
VITE_ACCOUNT_REFRESH_MS=5000
VITE_POSITIONS_REFRESH_MS=5000
VITE_TRADES_REFRESH_MS=10000
VITE_PERFORMANCE_REFRESH_MS=30000
VITE_RISK_REFRESH_MS=5000
VITE_STATUS_REFRESH_MS=5000
